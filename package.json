{
  "name": "fontanelle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@turf/distance": "^6.5.0",
    "@types/lodash": "^4.14.170",
    "@types/mapbox-gl": "^2.3.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "localforage": "^1.10.0",
    "localforage-getitems": "^1.4.2",
    "lodash": "^4.17.21",
    "mapbox-gl-circle": "^1.6.5",
    "opening_hours": "^3.8.0",
    "osm-auth": "^2.0.0",
    "react": "^18",
    "react-dom": "^18",
    "react-top-loading-bar": "^2.1.0",
    "sass": "^1.34.1",
    "vaul": "^1.1.2",
    "workbox-cacheable-response": "^7.0.0",
    "workbox-core": "^7.0.0",
    "workbox-expiration": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0",
    "zustand": "^4"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p functions/tsconfig.json --noEmit",
